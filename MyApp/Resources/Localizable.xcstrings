    "settings.disclaimer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ElecCalc results are for engineering guidance. They do not replace the judgment of a licensed engineer, applicable codes, or site-specific verification."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ElecCalc sonuçları mühendislik çalışmalarına yardımcı olmak içindir. Yetkili mühendis kontrolünün, yürürlükteki yönetmeliklerin ve sahaya özgü doğrulamanın yerine geçmez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ElecCalc-Ergebnisse dienen der ingenieurtechnischen Orientierung. Sie ersetzen nicht das Urteil eines zugelassenen Ingenieurs, geltende Vorschriften oder die Überprüfung vor Ort."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les résultats d’ElecCalc sont fournis à titre d’aide à l’ingénierie. Ils ne remplacent pas le jugement d’un ingénieur agréé, les réglementations applicables ni la vérification sur site."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los resultados de ElecCalc son una guía de ingeniería. No sustituyen el criterio de un ingeniero colegiado, la normativa aplicable ni la verificación en obra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I risultati di ElecCalc sono un supporto ingegneristico. Non sostituiscono il giudizio di un ingegnere abilitato, le norme applicabili né le verifiche in loco."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os resultados do ElecCalc são orientações de engenharia. Eles não substituem o julgamento de um engenheiro habilitado, as normas aplicáveis nem a verificação no local."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ElecCalcの計算結果はエンジニアリングの参考情報です。有資格技術者の判断、適用される規格、現場での検証に代わるものではありません。"
          }
        }
      }
    },
