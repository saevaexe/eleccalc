    "assumption.breakerSelection": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Overload condition only (IEC 60364-4-43 §433.1). Short-circuit breaking capacity and selectivity must be verified separately. Results do not replace engineering review."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca aşırı yük koşulu esas alınır (IEC 60364-4-43 §433.1). Kısa devre kesme kapasitesi ve seçicilik ayrıca doğrulanmalıdır. Sonuçlar mühendislik kontrolünün yerine geçmez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nur Überlastschutz (IEC 60364-4-43 §433.1). Kurzschluss-Ausschaltvermögen und Selektivität sind separat zu prüfen. Ergebnisse ersetzen keine ingenieurtechnische Prüfung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Condition de surcharge uniquement (IEC 60364-4-43 §433.1). Le pouvoir de coupure en court-circuit et la sélectivité doivent être vérifiés séparément. Les résultats ne remplacent pas une étude d’ingénierie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Solo condición de sobrecarga (IEC 60364-4-43 §433.1). El poder de corte en cortocircuito y la selectividad deben verificarse por separado. Los resultados no sustituyen la revisión de ingeniería."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Solo condizione di sovraccarico (IEC 60364-4-43 §433.1). Il potere di interruzione in cortocircuito e la selettività vanno verificati separatamente. I risultati non sostituiscono la verifica ingegneristica."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apenas condição de sobrecarga (IEC 60364-4-43 §433.1). A capacidade de interrupção em curto-circuito e a seletividade devem ser verificadas separadamente. Os resultados não substituem a análise de engenharia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "過負荷条件のみ(IEC 60364-4-43 §433.1)。短絡遮断容量と選択遮断性は別途確認が必要です。計算結果は技術者による検証に代わるものではありません。"
          }
        }
      }
    },
    "assumption.cableAmpacity": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "IEC 60364-5-52:2009 — in air: Method E (multi-core), in conduit: B1, underground: D1 (in duct). Results do not replace engineering review."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "IEC 60364-5-52:2009 — havada: Metod E (çok damarlı), kanalda: B1, toprakta: D1 (boru içinde). Sonuçlar mühendislik kontrolünün yerine geçmez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "IEC 60364-5-52:2009 — in Luft: Verlegeart E (mehradrig), im Rohr: B1, im Erdreich: D1 (im Kabelkanal). Ergebnisse ersetzen keine ingenieurtechnische Prüfung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "IEC 60364-5-52:2009 — à l’air libre : méthode E (multiconducteur), sous conduit : B1, enterré : D1 (sous fourreau). Les résultats ne remplacent pas une étude d’ingénierie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "IEC 60364-5-52:2009 — al aire: método E (multiconductor), en tubo: B1, enterrado: D1 (en conducto). Los resultados no sustituyen la revisión de ingeniería."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "IEC 60364-5-52:2009 — in aria: metodo E (multipolare), in tubo: B1, interrato: D1 (in cavidotto). I risultati non sostituiscono la verifica ingegneristica."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "IEC 60364-5-52:2009 — ao ar livre: método E (multipolar), em eletroduto: B1, enterrado: D1 (em duto). Os resultados não substituem a análise de engenharia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "IEC 60364-5-52:2009 — 気中:施設方法E(多心)、電線管内:B1、地中:D1(ダクト内)。計算結果は技術者による検証に代わるものではありません。"
          }
        }
      }
    },
    "assumption.cableSection": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resistive voltage drop only; conductor resistivity at 70 °C operating temperature (Cu 0.0210, Al 0.0336 Ω·mm²/m). Verify ampacity separately. Results do not replace engineering review."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca omik gerilim düşümü; iletken özdirenci 70 °C işletme sıcaklığında (Cu 0.0210, Al 0.0336 Ω·mm²/m). Taşıma kapasitesi ayrıca doğrulanmalıdır. Sonuçlar mühendislik kontrolünün yerine geçmez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nur ohmscher Spannungsfall; spezifischer Leiterwiderstand bei 70 °C Betriebstemperatur (Cu 0,0210, Al 0,0336 Ω·mm²/m). Strombelastbarkeit separat prüfen. Ergebnisse ersetzen keine ingenieurtechnische Prüfung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chute de tension résistive uniquement ; résistivité du conducteur à 70 °C de température de fonctionnement (Cu 0,0210, Al 0,0336 Ω·mm²/m). Vérifiez le courant admissible séparément. Les résultats ne remplacent pas une étude d’ingénierie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Solo caída de tensión resistiva; resistividad del conductor a 70 °C de temperatura de funcionamiento (Cu 0,0210, Al 0,0336 Ω·mm²/m). Verifique la capacidad de corriente por separado. Los resultados no sustituyen la revisión de ingeniería."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Solo caduta di tensione resistiva; resistività del conduttore a 70 °C di temperatura di esercizio (Cu 0,0210, Al 0,0336 Ω·mm²/m). Verificare separatamente la portata. I risultati non sostituiscono la verifica ingegneristica."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apenas queda de tensão resistiva; resistividade do condutor a 70 °C de temperatura de operação (Cu 0,0210, Al 0,0336 Ω·mm²/m). Verifique a capacidade de condução separadamente. Os resultados não substituem a análise de engenharia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "抵抗性電圧降下のみ。導体抵抗率は動作温度70 °C時(Cu 0.0210、Al 0.0336 Ω·mm²/m)。許容電流は別途確認してください。計算結果は技術者による検証に代わるものではありません。"
          }
        }
      }
    },
    "assumption.grounding": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rod: R = ρ/(2πL)·ln(4L/d); plate: square-plate approximation ρ/(4a). Uniform soil resistivity assumed. Results do not replace engineering review."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çubuk: R = ρ/(2πL)·ln(4L/d); levha: kare levha yaklaşımı ρ/(4a). Homojen toprak özdirenci varsayılır. Sonuçlar mühendislik kontrolünün yerine geçmez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Staberder: R = ρ/(2πL)·ln(4L/d); Plattenerder: Näherung für quadratische Platte ρ/(4a). Homogener spezifischer Bodenwiderstand angenommen. Ergebnisse ersetzen keine ingenieurtechnische Prüfung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Piquet : R = ρ/(2πL)·ln(4L/d) ; plaque : approximation de plaque carrée ρ/(4a). Résistivité du sol supposée uniforme. Les résultats ne remplacent pas une étude d’ingénierie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pica: R = ρ/(2πL)·ln(4L/d); placa: aproximación de placa cuadrada ρ/(4a). Se asume resistividad del suelo uniforme. Los resultados no sustituyen la revisión de ingeniería."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Picchetto: R = ρ/(2πL)·ln(4L/d); piastra: approssimazione a piastra quadrata ρ/(4a). Si assume resistività del terreno uniforme. I risultati non sostituiscono la verifica ingegneristica."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Haste: R = ρ/(2πL)·ln(4L/d); placa: aproximação de placa quadrada ρ/(4a). Assume-se resistividade do solo uniforme. Os resultados não substituem a análise de engenharia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "棒状電極:R = ρ/(2πL)·ln(4L/d)、板状電極:正方形板近似 ρ/(4a)。土壌抵抗率は均一と仮定。計算結果は技術者による検証に代わるものではありません。"
          }
        }
      }
    },
