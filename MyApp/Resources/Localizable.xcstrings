    "assumption.breakerSelection" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overload condition only (IEC 60364-4-43 §433.1). Short-circuit breaking capacity and selectivity must be verified separately. Results do not replace engineering review."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca aşırı yük koşulu esas alınır (IEC 60364-4-43 §433.1). Kısa devre kesme kapasitesi ve seçicilik ayrıca doğrulanmalıdır. Sonuçlar mühendislik kontrolünün yerine geçmez."
          }
        }
      }
    },
    "assumption.cableAmpacity" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IEC 60364-5-52:2009 — in air: Method E (multi-core), in conduit: B1, underground: D1 (in duct). Results do not replace engineering review."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IEC 60364-5-52:2009 — havada: Metod E (çok damarlı), kanalda: B1, toprakta: D1 (boru içinde). Sonuçlar mühendislik kontrolünün yerine geçmez."
          }
        }
      }
    },
    "assumption.cableSection" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resistive voltage drop only; conductor resistivity at 70 °C operating temperature (Cu 0.0210, Al 0.0336 Ω·mm²/m). Verify ampacity separately. Results do not replace engineering review."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca omik gerilim düşümü; iletken özdirenci 70 °C işletme sıcaklığında (Cu 0.0210, Al 0.0336 Ω·mm²/m). Taşıma kapasitesi ayrıca doğrulanmalıdır. Sonuçlar mühendislik kontrolünün yerine geçmez."
          }
        }
      }
    },
    "assumption.grounding" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rod: R = ρ/(2πL)·ln(4L/d); plate: square-plate approximation ρ/(4a). Uniform soil resistivity assumed. Results do not replace engineering review."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çubuk: R = ρ/(2πL)·ln(4L/d); levha: kare levha yaklaşımı ρ/(4a). Homojen toprak özdirenci varsayılır. Sonuçlar mühendislik kontrolünün yerine geçmez."
          }
        }
      }
    },
    "assumption.motorCalc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IEC 60034-30-1:2014 efficiencies: 4-pole, 50 Hz. Results do not replace engineering review."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IEC 60034-30-1:2014 verimleri: 4 kutup, 50 Hz. Sonuçlar mühendislik kontrolünün yerine geçmez."
          }
        }
      }
    },
    "assumption.shortCircuit" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transformer impedance assumed ≈ pure reactance (Zt ≈ Xt); peak factor κ = 1.8. Infinite source assumed upstream. Results do not replace engineering review."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trafo empedansı ≈ saf reaktans kabul edilir (Zt ≈ Xt); darbe katsayısı κ = 1.8. Üst şebeke sonsuz güçlü varsayılır. Sonuçlar mühendislik kontrolünün yerine geçmez."
          }
        }
      }
    },
    "assumption.transformer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S = P/cosφ conversion; copper loss scales with loading squared. Results do not replace engineering review."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S = P/cosφ dönüşümü kullanılır; bakır kaybı yüklenmenin karesiyle ölçeklenir. Sonuçlar mühendislik kontrolünün yerine geçmez."
          }
        }
      }
    },
    "assumption.voltageDrop" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resistive drop only (cosφ = 1); conductor resistivity at 70 °C operating temperature. Results do not replace engineering review."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca omik düşüm (cosφ = 1); iletken özdirenci 70 °C işletme sıcaklığında. Sonuçlar mühendislik kontrolünün yerine geçmez."
          }
        }
      }
    },
