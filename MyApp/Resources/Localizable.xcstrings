    "paywall.disclosure": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscriptions automatically renew unless cancelled at least 24 hours before the end of the current period. You can manage and cancel your subscriptions in your App Store account settings."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonelikler, mevcut dönemin bitiminden en az 24 saat önce iptal edilmediği sürece otomatik olarak yenilenir. Aboneliklerinizi App Store hesap ayarlarınızdan yönetebilir ve iptal edebilirsiniz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abonnements verlängern sich automatisch, sofern sie nicht mindestens 24 Stunden vor Ablauf des aktuellen Zeitraums gekündigt werden. Sie können Ihre Abonnements in den Einstellungen Ihres App-Store-Kontos verwalten und kündigen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les abonnements se renouvellent automatiquement sauf annulation au moins 24 heures avant la fin de la période en cours. Vous pouvez gérer et annuler vos abonnements dans les réglages de votre compte App Store."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las suscripciones se renuevan automáticamente a menos que se cancelen al menos 24 horas antes del final del período actual. Puede gestionar y cancelar sus suscripciones en los ajustes de su cuenta del App Store."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gli abbonamenti si rinnovano automaticamente salvo disdetta almeno 24 ore prima della fine del periodo corrente. Puoi gestire e disdire gli abbonamenti nelle impostazioni del tuo account App Store."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As assinaturas são renovadas automaticamente, a menos que sejam canceladas pelo menos 24 horas antes do fim do período atual. Você pode gerenciar e cancelar suas assinaturas nos ajustes da sua conta da App Store."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "サブスクリプションは、現在の期間終了の24時間前までに解約しない限り自動更新されます。サブスクリプションの管理と解約はApp Storeのアカウント設定から行えます。"
          }
        }
      }
    },
