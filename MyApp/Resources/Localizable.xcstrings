{
  "sourceLanguage" : "en",
  "strings" : {
    "-" : {
      "comment" : "A placeholder text for an unselected option in a segmented control.",
      "isCommentAutoGenerated" : true
    },
    "·" : {

    },
    "%@ %@" : {
      "comment" : "A label displaying the cost of energy consumption. The argument is the cost formatted to 2 decimal places. The argument is the string “unit.currency”.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@"
          }
        }
      }
    },
    "%@ kWh" : {
      "comment" : "A subheading inside the energy consumption result view, showing the actual energy consumption for a given period. The argument is the energy consumption value for that period.",
      "isCommentAutoGenerated" : true
    },
    "%@ mm²" : {
      "comment" : "A pickable option in the cable ampacity calculator UI, showing a cable cross-sectional area in square millimeters. The value is formatted to one decimal place.",
      "isCommentAutoGenerated" : true
    },
    "%@: %@ %@" : {
      "comment" : "A view that displays a title, a value, and a unit, with an optional formula as a hint. The first argument is the title of the view. The second argument is the value displayed in the view. The third argument is the unit of measurement for the value. The fourth argument is an optional string that provides a hint or explanation about how to use or interpret the value.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@: %2$@ %3$@"
          }
        }
      }
    },
    "%@. %@" : {
      "comment" : "A single row in a list that summarizes a calculation record. The label of the view is a combination of the title and result summary of the record.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@. %2$@"
          }
        }
      }
    },
    "%%%@" : {
      "comment" : "A text displaying the percentage of the supply voltage that is dropped across a conductor. The value is displayed in bold text with a color that indicates whether the value is below, at, or above 5%.",
      "isCommentAutoGenerated" : true
    },
    "15" : {
      "comment" : "The number of calculators available in the app.",
      "isCommentAutoGenerated" : true
    },
