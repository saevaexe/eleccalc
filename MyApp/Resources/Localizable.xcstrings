    "assumption.shortCircuit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transformer impedance assumed ≈ pure reactance (Zt ≈ Xt); peak factor κ = 1.8. Infinite source assumed upstream. Results do not replace engineering review."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trafo empedansı ≈ saf reaktans kabul edilir (Zt ≈ Xt); darbe katsayısı κ = 1.8. Üst şebeke sonsuz güçlü varsayılır. Sonuçlar mühendislik kontrolünün yerine geçmez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Transformatorimpedanz angenommen ≈ reine Reaktanz (Zt ≈ Xt); Stoßfaktor κ = 1,8. Vorgelagertes Netz als unendlich starr angenommen. Ergebnisse ersetzen keine ingenieurtechnische Prüfung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impédance du transformateur supposée ≈ réactance pure (Zt ≈ Xt) ; facteur de crête κ = 1,8. Source amont supposée de puissance infinie. Les résultats ne remplacent pas une étude d’ingénierie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impedancia del transformador supuesta ≈ reactancia pura (Zt ≈ Xt); factor de cresta κ = 1,8. Se asume fuente aguas arriba de potencia infinita. Los resultados no sustituyen la revisión de ingeniería."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impedenza del trasformatore assunta ≈ reattanza pura (Zt ≈ Xt); fattore di cresta κ = 1,8. Rete a monte assunta di potenza infinita. I risultati non sostituiscono la verifica ingegneristica."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impedância do transformador assumida ≈ reatância pura (Zt ≈ Xt); fator de pico κ = 1,8. Fonte a montante assumida como infinita. Os resultados não substituem a análise de engenharia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "変圧器インピーダンスは純リアクタンスと仮定(Zt ≈ Xt)、波高率 κ = 1.8。上位系統は無限大母線と仮定。計算結果は技術者による検証に代わるものではありません。"
          }
        }
      }
    },
    "assumption.transformer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "S = P/cosφ conversion; copper loss scales with loading squared. Results do not replace engineering review."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "S = P/cosφ dönüşümü kullanılır; bakır kaybı yüklenmenin karesiyle ölçeklenir. Sonuçlar mühendislik kontrolünün yerine geçmez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Umrechnung S = P/cosφ; Kupferverluste skalieren quadratisch mit der Auslastung. Ergebnisse ersetzen keine ingenieurtechnische Prüfung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Conversion S = P/cosφ ; les pertes cuivre varient avec le carré de la charge. Les résultats ne remplacent pas une étude d’ingénierie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Conversión S = P/cosφ; las pérdidas en el cobre escalan con el cuadrado de la carga. Los resultados no sustituyen la revisión de ingeniería."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Conversione S = P/cosφ; le perdite nel rame scalano con il quadrato del carico. I risultati non sostituiscono la verifica ingegneristica."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Conversão S = P/cosφ; as perdas no cobre variam com o quadrado do carregamento. Os resultados não substituem a análise de engenharia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "S = P/cosφ による換算。銅損は負荷率の2乗に比例します。計算結果は技術者による検証に代わるものではありません。"
          }
        }
      }
    },
