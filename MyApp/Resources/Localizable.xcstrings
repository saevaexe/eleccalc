    "paywall.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock the complete set of electrical calculators built for engineers, technicians, and job-site decisions."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mühendisler, teknisyenler ve saha kararları için geliştirilen tüm elektrik hesaplayıcılarını açın."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Schalten Sie das komplette Set an Elektrorechnern frei — entwickelt für Ingenieure, Techniker und Entscheidungen auf der Baustelle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Débloquez l’ensemble complet de calculateurs électriques conçu pour les ingénieurs, les techniciens et les décisions sur chantier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Desbloquee el conjunto completo de calculadoras eléctricas creado para ingenieros, técnicos y decisiones a pie de obra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sblocca il set completo di calcolatori elettrici pensato per ingegneri, tecnici e decisioni in cantiere."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Desbloqueie o conjunto completo de calculadoras elétricas criado para engenheiros, técnicos e decisões em campo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "エンジニア・技術者・現場での判断のために作られた電気計算ツール一式をアンロック。"
          }
        }
      }
    },
